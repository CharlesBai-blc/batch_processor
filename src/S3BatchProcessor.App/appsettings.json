{
  "Aws": {
    "DefaultRegion": "us-east-1"
  },
  "Ec2": {
    "FilterTagKey": "BatchProcessor",
    "FilterTagValue": "true"
  },
  "Processing": {
    "ExecutablePath": "/opt/processor/run.sh",
    "OutputS3Prefix": "s3://output-bucket/results/"
  },
  "Ssm": {
    "CommandTimeoutSeconds": 600
  },
  "Preview": {
    "MaxFileSizeBytes": 1048576
  }
}
