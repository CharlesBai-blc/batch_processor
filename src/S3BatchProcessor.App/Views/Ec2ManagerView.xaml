<UserControl x:Class="S3BatchProcessor.App.Views.Ec2ManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:S3BatchProcessor.App.ViewModels"
             xmlns:models="clr-namespace:S3BatchProcessor.App.Models"
             xmlns:conv="clr-namespace:S3BatchProcessor.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:Ec2ManagerViewModel}"
             d:DesignHeight="500" d:DesignWidth="900">

    <UserControl.Resources>
        <conv:InstanceStateToColorConverter x:Key="StateColorConverter" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <Grid>
        <!-- Error banner -->
        <Border Background="#FFF0F0" BorderBrush="#FF4444" BorderThickness="0,0,0,1"
                Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisConverter}}"
                Padding="8,4" VerticalAlignment="Top" Panel.ZIndex="10">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#CC0000" TextWrapping="Wrap" />
        </Border>

        <!-- Loading overlay -->
        <Border Background="#80FFFFFF" Panel.ZIndex="5"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}">
            <TextBlock Text="Loading instances..." HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="18" Foreground="Gray" />
        </Border>

        <DockPanel Margin="8">
            <!-- Top bar -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock Text="On-Demand Instances" FontWeight="SemiBold" FontSize="16"
                           VerticalAlignment="Center" DockPanel.Dock="Left" />
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <CheckBox Content="Auto-refresh" IsChecked="{Binding IsAutoRefreshEnabled}"
                              VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Content="Refresh" Command="{Binding RefreshInstancesCommand}" Padding="12,4" />
                </StackPanel>
            </DockPanel>

            <!-- Bottom bar -->
            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button Content="Continue →" DockPanel.Dock="Right" Padding="12,4"
                        IsEnabled="{Binding SelectedInstanceCount}" />
                <TextBlock VerticalAlignment="Center">
                    <Run Text="{Binding SelectedInstanceCount, Mode=OneWay}" />
                    <Run Text=" instances selected" />
                </TextBlock>
            </DockPanel>

            <!-- Instance cards -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding InstancesView}">
                    <ItemsControl.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               Foreground="#555555" FontSize="13"
                                               Margin="0,12,0,6" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ItemsControl.GroupStyle>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:Ec2InstanceItem}">
                            <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4"
                                    Padding="12" Margin="0,0,10,10" Width="210">
                                <StackPanel>
                                    <TextBlock Text="{Binding NameTag}" FontWeight="SemiBold"
                                               FontSize="13" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding InstanceId}" Foreground="Gray"
                                               FontSize="10" Margin="0,1,0,4" />
                                    <TextBlock Text="{Binding InstanceType}" FontSize="12"
                                               Margin="0,0,0,4" />

                                    <!-- State indicator -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Ellipse Width="10" Height="10" Margin="0,0,6,0"
                                                 Fill="{Binding State, Converter={StaticResource StateColorConverter}}" />
                                        <TextBlock Text="{Binding State}" FontSize="12" />
                                    </StackPanel>

                                    <TextBlock FontSize="11" Foreground="Gray" Margin="0,0,0,2">
                                        <Run Text="AZ: " />
                                        <Run Text="{Binding AvailabilityZone, Mode=OneWay}" />
                                    </TextBlock>

                                    <!-- SSM Test result -->
                                    <TextBlock Text="{Binding SsmTestResult}" FontSize="10"
                                               Foreground="#666666" Margin="0,2,0,4"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding SsmTestResult, Converter={StaticResource BoolToVisConverter}}" />

                                    <!-- Buttons -->
                                    <WrapPanel Margin="0,4,0,0">
                                        <Button Content="Start" Padding="8,3" Margin="0,0,4,4"
                                                FontSize="11"
                                                Command="{Binding DataContext.StartInstanceCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding State}" Value="Stopped">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="Stop" Padding="8,3" Margin="0,0,4,4"
                                                FontSize="11"
                                                Command="{Binding DataContext.StopInstanceCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding State}" Value="Running">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="Select" Padding="8,3" Margin="0,0,4,4"
                                                FontSize="11"
                                                Command="{Binding DataContext.ToggleSelectCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="SSM Test" Padding="8,3" Margin="0,0,4,4"
                                                FontSize="11"
                                                Command="{Binding DataContext.RunSsmTestCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding State}" Value="Running">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
