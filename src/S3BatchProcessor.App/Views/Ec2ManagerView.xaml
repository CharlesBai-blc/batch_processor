<UserControl x:Class="S3BatchProcessor.App.Views.Ec2ManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:S3BatchProcessor.App.ViewModels"
             xmlns:models="clr-namespace:S3BatchProcessor.App.Models"
             xmlns:conv="clr-namespace:S3BatchProcessor.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:Ec2ManagerViewModel}"
             d:DesignHeight="500" d:DesignWidth="900">

    <UserControl.Resources>
        <conv:InstanceStateToColorConverter x:Key="StateColorConverter" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConverter" />
        <conv:InverseBoolConverter x:Key="InverseBoolConverter" />
    </UserControl.Resources>

    <Grid>
        <!-- Error banner -->
        <Border Background="#FFF0F0" BorderBrush="#FF4444" BorderThickness="0,0,0,1"
                Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisConverter}}"
                Padding="8,4" VerticalAlignment="Top" Panel.ZIndex="10">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#CC0000" TextWrapping="Wrap" />
        </Border>

        <!-- Loading overlay -->
        <Border Background="#80FFFFFF" Panel.ZIndex="5"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}">
            <TextBlock Text="Loading instances..." HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="18" Foreground="Gray" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: Instance browser -->
            <DockPanel Grid.Column="0" Margin="8">
                <!-- Top bar -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="Instances" FontWeight="SemiBold" FontSize="16"
                               VerticalAlignment="Center" DockPanel.Dock="Left" />
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <CheckBox Content="Auto-refresh" IsChecked="{Binding IsAutoRefreshEnabled}"
                                  VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button Content="Refresh" Command="{Binding RefreshInstancesCommand}" Padding="12,4" />
                    </StackPanel>
                </DockPanel>

                <!-- Search bar -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="4,3" FontSize="12"
                             ToolTip="Filter instances by name" />
                </DockPanel>

                <!-- Spot Instance Launch Panel -->
                <Expander DockPanel.Dock="Bottom" IsExpanded="False" Margin="0,8,0,0">
                    <Expander.Header>
                        <TextBlock Text="Add Spot Instances" FontWeight="SemiBold" FontSize="13" />
                    </Expander.Header>
                    <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,4,0,0">
                        <StackPanel>
                            <!-- Region -->
                            <TextBlock Text="Region" FontSize="12" Foreground="#555" Margin="0,0,0,3" />
                            <ComboBox ItemsSource="{Binding ScanRegions}"
                                      SelectedItem="{Binding SelectedSpotRegion}"
                                      Margin="0,0,0,8" />

                            <!-- Launch Template -->
                            <TextBlock Text="Launch Template" FontSize="12" Foreground="#555" Margin="0,0,0,3" />
                            <ComboBox ItemsSource="{Binding LaunchTemplates}"
                                      SelectedItem="{Binding SelectedLaunchTemplate}"
                                      DisplayMemberPath="DisplayName"
                                      IsEnabled="{Binding IsLoadingTemplates, Converter={StaticResource InverseBoolConverter}}"
                                      Margin="0,0,0,8" />

                            <!-- Count -->
                            <TextBlock Text="Instance Count" FontSize="12" Foreground="#555" Margin="0,0,0,3" />
                            <TextBox Text="{Binding SpotInstanceCount, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,8" MaxWidth="80" HorizontalAlignment="Left" />

                            <!-- Launch Button -->
                            <Button Content="Add Spot Instances"
                                    Command="{Binding LaunchSpotInstancesCommand}"
                                    IsEnabled="{Binding IsLaunchingSpot, Converter={StaticResource InverseBoolConverter}}"
                                    Padding="12,5" HorizontalAlignment="Left" Margin="0,0,0,6" />

                            <!-- Status -->
                            <TextBlock Text="{Binding SpotLaunchStatus}" FontSize="11"
                                       Foreground="#666666" TextWrapping="Wrap"
                                       Visibility="{Binding SpotLaunchStatus, Converter={StaticResource BoolToVisConverter}}" />
                        </StackPanel>
                    </Border>
                </Expander>

                <!-- Instance cards -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding InstancesView}">
                        <ItemsControl.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="GroupItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="GroupItem">
                                                    <Expander IsExpanded="True" Margin="0,4,0,0">
                                                        <Expander.Header>
                                                            <TextBlock FontWeight="SemiBold" Foreground="#555555" FontSize="13">
                                                                <Run Text="{Binding Name, Mode=OneWay}" />
                                                                <Run Text=" (" /><Run Text="{Binding ItemCount, Mode=OneWay}" /><Run Text=")" />
                                                            </TextBlock>
                                                        </Expander.Header>
                                                        <ItemsPresenter Margin="0,4,0,0" />
                                                    </Expander>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </ItemsControl.GroupStyle>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:Ec2InstanceItem}">
                                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4"
                                        Padding="12" Margin="0,0,10,10" Width="210">
                                    <StackPanel>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" CornerRadius="3"
                                                    Background="#E87D0D" Padding="5,1" Margin="4,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding IsSpot, Converter={StaticResource BoolToVisConverter}}">
                                                <TextBlock Text="SPOT" Foreground="White"
                                                           FontSize="9" FontWeight="Bold" />
                                            </Border>
                                            <TextBlock Text="{Binding NameTag}" FontWeight="SemiBold"
                                                       FontSize="13" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding InstanceId}" Foreground="Gray"
                                                   FontSize="10" Margin="0,1,0,4" />
                                        <TextBlock Text="{Binding InstanceType}" FontSize="12"
                                                   Margin="0,0,0,4" />

                                        <!-- State indicator -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Ellipse Width="10" Height="10" Margin="0,0,6,0"
                                                     Fill="{Binding State, Converter={StaticResource StateColorConverter}}" />
                                            <TextBlock Text="{Binding State}" FontSize="12" />
                                        </StackPanel>

                                        <TextBlock FontSize="11" Foreground="Gray" Margin="0,0,0,2">
                                            <Run Text="AZ: " />
                                            <Run Text="{Binding AvailabilityZone, Mode=OneWay}" />
                                        </TextBlock>

                                        <!-- Buttons -->
                                        <WrapPanel Margin="0,4,0,0">
                                            <Button Content="Select" Padding="8,3" Margin="0,0,4,4"
                                                    FontSize="11"
                                                    Command="{Binding DataContext.ToggleSelectCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Stretch"
                          Background="#DDDDDD" />

            <!-- RIGHT: Selected instances pane -->
            <DockPanel Grid.Column="2" Margin="8">
                <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <Button Content="Continue →" Padding="10,3" DockPanel.Dock="Right"
                            Command="{Binding ContinueCommand}"
                            IsEnabled="{Binding SelectedInstanceCount}" />
                </DockPanel>

                <DockPanel>
                    <Expander DockPanel.Dock="Top" IsExpanded="True">
                        <Expander.Header>
                            <TextBlock>
                                <Run Text="Selected Instances (" /><Run Text="{Binding SelectedInstanceCount, Mode=OneWay}" /><Run Text=")" FontWeight="SemiBold" />
                            </TextBlock>
                        </Expander.Header>
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                                <Button Content="Clear All" Padding="8,3"
                                        Command="{Binding ClearSelectedCommand}"
                                        IsEnabled="{Binding SelectedInstanceCount}" />
                            </DockPanel>
                            <ListBox ItemsSource="{Binding SelectedInstancesView}"
                                     BorderThickness="1" BorderBrush="#CCCCCC">
                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                           Foreground="#555555" FontSize="11"
                                                           Margin="4,6,0,2" />
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ListBox.GroupStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:Ec2InstanceItem}">
                                        <DockPanel Margin="0,1,0,1">
                                            <Button Content="✕" DockPanel.Dock="Left" Padding="4,0"
                                                    FontSize="10" Background="Transparent" BorderThickness="0"
                                                    Cursor="Hand" VerticalAlignment="Center" Margin="0,0,4,0"
                                                    ToolTip="Remove"
                                                    Command="{Binding DataContext.ToggleSelectCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <TextBlock Text="{Binding NameTag}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding InstanceId}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Expander>
                </DockPanel>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
