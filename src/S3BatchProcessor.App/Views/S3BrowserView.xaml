<UserControl x:Class="S3BatchProcessor.App.Views.S3BrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:S3BatchProcessor.App.ViewModels"
             xmlns:models="clr-namespace:S3BatchProcessor.App.Models"
             xmlns:conv="clr-namespace:S3BatchProcessor.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:S3BrowserViewModel}"
             d:DesignHeight="500" d:DesignWidth="900">

    <UserControl.Resources>
        <conv:FileSizeConverter x:Key="FileSizeConverter" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <Grid>
        <!-- Error banner -->
        <Border Background="#FFF0F0" BorderBrush="#FF4444" BorderThickness="0,0,0,1"
                Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisConverter}}"
                DockPanel.Dock="Top" Padding="8,4" VerticalAlignment="Top" Panel.ZIndex="10">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#CC0000" TextWrapping="Wrap" />
        </Border>

        <!-- Loading overlay -->
        <Border Background="#80FFFFFF" Panel.ZIndex="5"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}">
            <TextBlock Text="Loading..." HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="18" Foreground="Gray" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: Bucket sidebar -->
            <DockPanel Grid.Column="0">
                <TextBlock Text="Buckets" FontWeight="SemiBold" FontSize="14"
                           Margin="8,8,8,4" DockPanel.Dock="Top" />
                <ListBox ItemsSource="{Binding BucketsView}"
                         Margin="4,0,4,4"
                         BorderThickness="0"
                         SelectionChanged="BucketListBox_SelectionChanged">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               Foreground="#555555" FontSize="11"
                                               Margin="4,8,0,2" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Margin="8,1,0,1" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Stretch"
                          Background="#DDDDDD" />

            <!-- CENTER: Object list -->
            <DockPanel Grid.Column="2" Margin="8,8,8,0">
                <!-- Breadcrumb bar -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Button Content="◀ Back" Command="{Binding NavigateBackCommand}"
                            Padding="6,2" DockPanel.Dock="Left" Margin="0,0,8,0" />
                    <ItemsControl ItemsSource="{Binding BreadcrumbSegments}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{Binding Label}"
                                            Command="{Binding DataContext.NavigateToBreadcrumbCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Prefix}"
                                            Padding="4,2" Margin="0,0,2,0"
                                            Background="Transparent" BorderThickness="0"
                                            Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <TextBlock Text="{Binding Label}" Foreground="#0066CC"
                                                           TextDecorations="Underline" Cursor="Hand"
                                                           Margin="2,0" />
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <TextBlock Text=" / " Foreground="Gray" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>

                <!-- Filter row -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <CheckBox Content="Filter TIFF/LAS only"
                              IsChecked="{Binding FilterTiffLasOnly}"
                              VerticalAlignment="Center" DockPanel.Dock="Left" />
                    <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" Foreground="Gray"
                               DockPanel.Dock="Left">
                        <Run Text="Showing " />
                        <Run Text="{Binding VisibleItemCount, Mode=OneWay}" />
                        <Run Text=" of " />
                        <Run Text="{Binding TotalItemCount, Mode=OneWay}" />
                        <Run Text=" items" />
                    </TextBlock>
                    <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" Foreground="Gray"
                               DockPanel.Dock="Left">
                        <Run Text="Staged: " />
                        <Run Text="{Binding StagedSelectionCount, Mode=OneWay}" />
                    </TextBlock>
                </DockPanel>

                <!-- File list -->
                <ListView ItemsSource="{Binding ItemsView}"
                          SelectionMode="Single"
                          SelectionChanged="FileListView_SelectionChanged"
                          MouseDoubleClick="FileListView_MouseDoubleClick"
                          BorderThickness="1" BorderBrush="#CCCCCC">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="34">
                                <GridViewColumn.Header>
                                    <CheckBox HorizontalAlignment="Center"
                                              IsThreeState="True"
                                              IsChecked="{Binding DataContext.IsAllChecked,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type models:S3ObjectItem}">
                                        <CheckBox HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding IsStaged, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Command="{Binding DataContext.ToggleItemCheckedCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}">
                                            <CheckBox.Style>
                                                <Style TargetType="CheckBox">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </CheckBox.Style>
                                        </CheckBox>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Name" Width="320">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type models:S3ObjectItem}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Margin="0,0,6,0" FontSize="14">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="📄" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                                <Setter Property="Text" Value="📁" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Size" Width="100"
                                            DisplayMemberBinding="{Binding Size,
                                                Converter={StaticResource FileSizeConverter}}" />
                            <GridViewColumn Header="Modified" Width="160"
                                            DisplayMemberBinding="{Binding LastModified,
                                                StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>

            <GridSplitter Grid.Column="3" Width="1" HorizontalAlignment="Stretch"
                          Background="#DDDDDD" />

            <!-- RIGHT: Staged + Committed selections pane -->
            <DockPanel Grid.Column="4" Margin="8">
                <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <Button Content="Continue →" Padding="10,3" DockPanel.Dock="Right"
                            Command="{Binding ContinueCommand}"
                            IsEnabled="{Binding SelectedFileCount}" />
                </DockPanel>

                <DockPanel>
                    <!-- Top: Staged (checked) files — sizes to content, collapses to header -->
                    <Expander DockPanel.Dock="Top" IsExpanded="True" Margin="0,0,0,4"
                              MaxHeight="300">
                        <Expander.Header>
                            <TextBlock>
                                <Run Text="Staged (" /><Run Text="{Binding StagedSelectionCount, Mode=OneWay}" /><Run Text=")" FontWeight="SemiBold" />
                                <Run Text="  " /><Run Text="{Binding StagedSizeDisplay, Mode=OneWay}" Foreground="Gray" FontSize="10" />
                            </TextBlock>
                        </Expander.Header>
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                                <Button Content="Select for processing" Padding="8,3"
                                        Command="{Binding SelectForProcessingCommand}"
                                        IsEnabled="{Binding HasStagedSelections}" />
                                <Button Content="Clear" Padding="8,3" DockPanel.Dock="Right"
                                        HorizontalAlignment="Right"
                                        Command="{Binding ClearStagedCommand}"
                                        IsEnabled="{Binding HasStagedSelections}" />
                            </DockPanel>
                            <ListBox ItemsSource="{Binding StagedDisplayView}"
                                     BorderThickness="1" BorderBrush="#CCCCCC">
                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                           Foreground="#555555" FontSize="11"
                                                           Margin="4,6,0,2" />
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ListBox.GroupStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:S3ObjectItem}">
                                        <DockPanel Margin="8,1,0,1">
                                            <Button Content="✕" DockPanel.Dock="Right" Padding="4,0"
                                                    FontSize="10" Background="Transparent" BorderThickness="0"
                                                    Cursor="Hand" VerticalAlignment="Center"
                                                    ToolTip="Unstage"
                                                    Command="{Binding DataContext.RemoveStagedItemCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Key}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Expander>

                    <!-- Bottom: Committed (selected for processing) files — fills remaining -->
                    <Expander IsExpanded="True" Margin="0,4,0,0">
                        <Expander.Header>
                            <TextBlock>
                                <Run Text="Selected for Processing (" /><Run Text="{Binding SelectedFileCount, Mode=OneWay}" /><Run Text=")" FontWeight="SemiBold" />
                                <Run Text="  " /><Run Text="{Binding SelectedSizeDisplay, Mode=OneWay}" Foreground="Gray" FontSize="10" />
                            </TextBlock>
                        </Expander.Header>
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                                <Button Content="Clear All" Padding="8,3"
                                        Command="{Binding ClearCommittedCommand}"
                                        IsEnabled="{Binding SelectedFileCount}" />
                            </DockPanel>
                            <ListBox ItemsSource="{Binding CommittedSelectionsView}"
                                     BorderThickness="1" BorderBrush="#CCCCCC">
                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                           Foreground="#555555" FontSize="11"
                                                           Margin="4,6,0,2" />
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ListBox.GroupStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:S3ObjectItem}">
                                        <DockPanel Margin="8,1,0,1">
                                            <Button Content="✕" DockPanel.Dock="Right" Padding="4,0"
                                                    FontSize="10" Background="Transparent" BorderThickness="0"
                                                    Cursor="Hand" VerticalAlignment="Center"
                                                    ToolTip="Remove"
                                                    Command="{Binding DataContext.RemoveCommittedItemCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Key}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Expander>
                </DockPanel>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
