<Window x:Class="S3BatchProcessor.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:S3BatchProcessor.App.Views"
        xmlns:vm="clr-namespace:S3BatchProcessor.App.ViewModels"
        xmlns:conv="clr-namespace:S3BatchProcessor.App.Converters"
        mc:Ignorable="d"
        Title="S3 Batch Processor"
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance vm:MainViewModel}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConverter" />
    </Window.Resources>

    <DockPanel>
        <!-- Status Bar -->
        <StatusBar DockPanel.Dock="Bottom" DataContext="{Binding StatusBar}" Padding="4,2">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="Gray" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="Green" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding IdentityDisplay}" VerticalAlignment="Center" />
                </StackPanel>
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Region:" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <ComboBox ItemsSource="{Binding AvailableRegions}"
                              SelectedItem="{Binding SelectedRegion}"
                              DisplayMemberPath="SystemName"
                              Width="130" VerticalAlignment="Center" />
                </StackPanel>
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="Red"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisConverter}}" />
            </StatusBarItem>
        </StatusBar>

        <!-- Tab Control -->
        <TabControl SelectedIndex="{Binding SelectedTabIndex}" Padding="4">
            <TabItem Header="1. Select Files">
                <views:S3BrowserView DataContext="{Binding S3Browser}" />
            </TabItem>
            <TabItem Header="2. Select Instances">
                <views:Ec2ManagerView DataContext="{Binding Ec2Manager}" />
            </TabItem>
            <TabItem Header="3. Assign &amp; Run">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <views:JobAssignmentView Grid.Row="0" DataContext="{Binding JobAssignment}" />
                    <views:JobExecutionView Grid.Row="1" DataContext="{Binding JobExecution}" />
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
